# Mnemos — every environment variable, in one file.
#
# Copy to `.env` and set what you need:   cp .env.example .env
# Docker Compose reads `.env` to fill docker-compose.yml (and
# docker-compose.prod.yml); the `ingester` service also receives the whole
# file as its environment. Sections go from "you will set this" to "only when
# running outside Compose". A commented line shows the default.

# ============================================================================
# === Getting started
# ============================================================================

# Where Mnemos finds your code on the host (mounted at /data/codebase).
# The default, an empty ./data/codebase, indexes nothing.
#   MNEMOS_CODEBASE_HOST_PATH=~/code
MNEMOS_CODEBASE_HOST_PATH=./data/codebase

# Your Claude Code config (skills + docs to index), mounted at /data/claude-config.
MNEMOS_CLAUDE_CONFIG_HOST_PATH=./data/claude-config

# LLM for memory extraction, dedup merge, contextual chunking and CRAG:
# `ollama` | `anthropic` | `openai` (or any OpenAI-compatible endpoint).
MNEMOS_LLM_PROVIDER=ollama
# Model name, provider-specific:
#   ollama:     llama3.1:8b, qwen2.5:7b, mistral, …
#   anthropic:  claude-opus-4-7, claude-sonnet-4-6, claude-haiku-4-5
#   openai:     gpt-4o, gpt-4o-mini, or any model on a compatible endpoint
MNEMOS_LLM_MODEL=llama3.1:8b
# Required for anthropic / openai; leave blank for ollama.
MNEMOS_LLM_API_KEY=
# OpenAI-compatible endpoint (vLLM, LM Studio, Groq, Together, OpenRouter…);
# overrides MNEMOS_OLLAMA_URL when set.
# MNEMOS_LLM_BASE_URL=
# Ollama URL. Blank: probed in order — bundled `ollama` service,
# host.docker.internal, localhost — first one with a model pulled wins.
# MNEMOS_OLLAMA_URL=

# Embedding model. google/embeddinggemma-2 roughly doubles code-search MRR
# over MiniLM (docs/EVAL.md) but indexes ~20x slower on CPU. Changing it on an
# existing index needs a migration (docs/CONFIGURATION.md); the server refuses
# to start on collections sized for another model.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================================================
# === Images
# ============================================================================

# Pin a version, or point at a local build (docker-compose.dev.yml builds
# mnemos-server:dev, mnemos-watcher:dev, mnemos-cli:dev). A local image cannot
# be pulled: keep the policy at `missing` (or `never`) for those.
# MNEMOS_SERVER_IMAGE=jamyouss/mnemos-server:latest
# MNEMOS_WATCHER_IMAGE=jamyouss/mnemos-watcher:latest
# MNEMOS_CLI_IMAGE=jamyouss/mnemos-cli:latest
# MNEMOS_PULL_POLICY=missing

# ============================================================================
# === Production — authentication and shared configuration
# ============================================================================
# docker-compose.prod.yml turns authentication on (MNEMOS_AUTH_ENABLED=true is
# set there, not here) and passes QDRANT_API_KEY and MNEMOS_BOOTSTRAP_ADMIN_KEY.

# Qdrant API key, given to Qdrant (QDRANT__SERVICE__API_KEY) and rag-server.
# Required with authentication: the server refuses to start without it and
# docker-compose.prod.yml refuses to render. `openssl rand -hex 32`.
# Never set it empty in front of Qdrant: an empty key locks every client out.
# QDRANT_API_KEY=

# First admin key, used only when the database holds no tenant and no
# tenants.yaml is mounted (docker-compose.prod.yml mounts config/tenants.yaml
# when present). Auth on and still no tenant → the server refuses to start.
# Manage tenants and their project scopes from the dashboard afterwards.
# MNEMOS_BOOTSTRAP_ADMIN_KEY=

# Let the dashboard save the shared configuration: settings overrides,
# connectors, projects, tenants. Stored in Qdrant and applied by every server
# pod; overrides win over the values in this file. With auth off, anyone who
# reaches :8100 can change it — enable auth first on anything but a private
# machine.
MNEMOS_UI_CONFIG_WRITABLE=false

# How often each server pod checks Qdrant for configuration saved elsewhere, in seconds.
# MNEMOS_CONFIG_POLL_SECONDS=5

# Index only the prefixes the projects mapping declares. The watcher walks the
# whole codebase mount; this is the only place that scope can be enforced.
# MNEMOS_INDEX_ONLY_DECLARED_PATHS=false

# ============================================================================
# === Observability
# ============================================================================

# Append every retrieval call to a JSONL log (needed by the Search page).
MNEMOS_QUERY_LOG_ENABLED=false
# MNEMOS_QUERY_LOG_PATH=/data/state/query-log.jsonl

# ============================================================================
# === Retrieval and indexing knobs
# ============================================================================
# Every stage below is off by default: each trades latency for precision or
# recall. Read docs/RETRIEVAL_PIPELINE.md before turning one on in production;
# all of them can also be changed live from the dashboard's Configuration page.

# --- Cross-encoder reranker -------------------------------------------------
# +~9 MRR points. Slow on CPU (~10 s/query with bge-base), fast on GPU.
# MNEMOS_RERANKER_ENABLED=false
# MNEMOS_RERANKER_MODEL=BAAI/bge-reranker-base
# MNEMOS_RERANKER_TYPE=cross-encoder
# Tokens per (query, chunk) pair; 0 keeps the model's own limit.
# MNEMOS_RERANKER_MAX_LENGTH=256

# --- MMR diversification (after rerank) -------------------------------------
# MNEMOS_MMR_ENABLED=false
# MNEMOS_MMR_LAMBDA=0.5

# --- CRAG corrective loop ---------------------------------------------------
# The grader scores each chunk with the LLM; when every chunk scores `low`, the
# rewriter generates query variants and retrieval runs again. One LLM call per
# chunk: pair with a fast model.
# MNEMOS_GRADER_ENABLED=false
# MNEMOS_GRADER_WORKERS=4
# MNEMOS_REWRITER_ENABLED=false
# MNEMOS_REWRITER_STRATEGY=expansion      # expansion | decompose | hyde
# MNEMOS_REWRITER_MAX_VARIANTS=3

# --- Semantic cache ---------------------------------------------------------
# Replays results for a query close enough to one already answered.
# MNEMOS_CACHE_ENABLED=false
# MNEMOS_CACHE_THRESHOLD=0.95
# MNEMOS_CACHE_TTL_SECONDS=3600

# --- Fusion and response size -----------------------------------------------
# Dense weight in the dense/BM25 RRF fusion; 1.0 is plain RRF.
# MNEMOS_FUSION_DENSE_WEIGHT=3.0
# Upper bound, in characters, of one MCP tool response.
# MNEMOS_RESPONSE_BUDGET_CHARS=32000

# --- Contextual chunking (indexing side) -----------------------------------
# One LLM call per chunk at index time to prepend a context sentence.
# Expensive: plan the full reindex.
# MNEMOS_CONTEXTUAL_ENABLED=false
# MNEMOS_CONTEXTUAL_WORKERS=4
# Split chunks longer than this many characters; 0 keeps the chunkers' own
# boundaries. Changing it needs `core.embedding_migration --max-chunk-chars`.
# MNEMOS_MAX_CHUNK_CHARS=0

# --- Memory dedup -----------------------------------------------------------
# Cosine similarity above which a new memory merges into (`merge`, via the
# LLM) or replaces (`replace`) an existing one. Calibrated on a 15-memory
# corpus: the one real near-duplicate sat at 0.844, the next pair at 0.646.
# MNEMOS_DEDUP_THRESHOLD=0.80
# MNEMOS_DEDUP_STRATEGY=merge

# ============================================================================
# === Clients — ingester, CLI, scripts, git hooks
# ============================================================================

# Key sent by every client when the server has auth enabled. The ingester and
# the scripts reading /api/connectors or /api/projects need a key with the
# admin role or write "*".
# MNEMOS_API_KEY=

# Server URL for the CLI, scripts and git hooks (Compose services set their own).
# MNEMOS_URL=http://localhost:8100

# Connector tokens, read by the ingester. A source names its variable with
# `token_env`; these are the defaults. URL and user also feed the one-off
# `mnemos ingest confluence|jira|git` commands.
# CONFLUENCE_URL=
# CONFLUENCE_USER=
# CONFLUENCE_TOKEN=
# JIRA_URL=
# JIRA_USER=
# JIRA_TOKEN=
# GIT_USER=
# GIT_TOKEN=
# Extra CA bundle for connectors behind a TLS-inspecting proxy
# (HTTPS_PROXY / NO_PROXY work as usual).
# SSL_CERT_FILE=

# `mnemos ingest run|serve` read the connectors from the server; set this to
# sync from a file instead (one-off or local runs). Keep it out of a `.env`
# used by Compose: the ingester service would leave server mode. The server
# reads the same variable as its one-time import source (below).
# MNEMOS_CONNECTORS_CONFIG=

# `mnemos eval` working directory (datasets and runs).
# MNEMOS_EVAL_ROOT=evals

# Git hooks (scripts/install-hooks.sh). They read the shell environment, then
# ~/.config/mnemos/config, written by install-hooks.sh: GUI clients never load
# a shell profile, so the file is the reliable channel.
# MNEMOS_CONFIG_FILE=~/.config/mnemos/config
# Host directory mounted at /data/codebase: must match MNEMOS_CODEBASE_HOST_PATH.
# MNEMOS_CODEBASE_ROOT=~/code
# When memory extraction runs: `pre-push` or `post-commit`.
# MNEMOS_HOOK_TRIGGER=pre-push
# Repos whose commits feed memory extraction (one LLM call per trigger).
# MNEMOS_REPOS_CONFIG=~/.config/mnemos/repos
# Repos indexed incrementally on merge/checkout; falls back to the list above.
# MNEMOS_INDEX_REPOS_CONFIG=~/.config/mnemos/index-repos
# Above this many changed files, one bulk reindex instead of per-file pushes.
# MNEMOS_MAX_INCREMENTAL_FILES=200
# Files larger than this are not pushed.
# MNEMOS_MAX_FILE_BYTES=1048576

# ============================================================================
# === Fixed by docker-compose.yml — only for running outside Compose
# ============================================================================
# Compose sets these itself (values below are what it uses); a value here does
# not reach the containers. Set them when you run the server, the watcher or
# `python -m core.embedding_migration` directly on the host.

# Qdrant. QDRANT_HTTPS for a TLS endpoint (Qdrant Cloud): qdrant-client would
# otherwise switch to TLS as soon as a key is set.
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333
# QDRANT_HTTPS=false

# Authentication switch (docker-compose.prod.yml sets it to true).
# MNEMOS_AUTH_ENABLED=false

# Container paths.
# CODEBASE_PATH=/data/codebase
# CLAUDE_CONFIG_PATH=/data/claude-config
# MNEMOS_STATE_DIR=/data/state
# MNEMOS_UI_PATH=/app/ui
# MNEMOS_UI_THEME_PATH=/app/config/theme.css
# MNEMOS_EVAL_RUNS_PATH=/app/evals/runs

# One-time import sources, read at the first start for each configuration the
# database does not hold yet; edit from the dashboard afterwards. Connectors:
# config/connectors.yaml, through MNEMOS_CONNECTORS_CONFIG (above).
# MNEMOS_PROJECTS_CONFIG_PATH=/app/config/projects.yaml
# MNEMOS_TENANTS_PATH=/data/config/tenants.yaml

# Watcher (service `watcher`).
# MNEMOS_SERVER_URL=http://rag-server:8100
# WATCHER_DEBOUNCE_MS=2000
