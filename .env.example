# Mnemos setup, read by every docker compose service: cp .env.example .env
# Active lines are what the stack needs: compose interpolation, container
# wiring, and values that differ from the server's built-in default.
# Commented lines show that default. Settings saved from the dashboard
# (stored in Qdrant) win over the values here.

# === Host ===================================================================
# Mounted at /data/codebase and /data/claude-config.
MNEMOS_CODEBASE_HOST_PATH=./data/codebase
MNEMOS_CLAUDE_CONFIG_HOST_PATH=./data/claude-config

# Local builds (docker-compose.dev.yml): mnemos-server:dev, mnemos-watcher:dev,
# mnemos-cli:dev — a local image cannot be pulled, keep the policy `missing`.
MNEMOS_SERVER_IMAGE=jamyouss/mnemos-server:latest
MNEMOS_WATCHER_IMAGE=jamyouss/mnemos-watcher:latest
MNEMOS_CLI_IMAGE=jamyouss/mnemos-cli:latest
MNEMOS_PULL_POLICY=missing

# === Wiring =================================================================
# Service names and container paths of docker-compose.yml.
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# qdrant-client switches to TLS as soon as a key is set; Compose's Qdrant is plain HTTP.
QDRANT_HTTPS=false
CODEBASE_PATH=/data/codebase
CLAUDE_CONFIG_PATH=/data/claude-config
MNEMOS_STATE_DIR=/data/state
# Used by the watcher and the ingester.
MNEMOS_SERVER_URL=http://rag-server:8100
MNEMOS_URL=http://rag-server:8100
# MNEMOS_UI_PATH=/app/ui
# MNEMOS_UI_THEME_PATH=/app/config/theme.css
# MNEMOS_EVAL_RUNS_PATH=/app/evals/runs

# === LLM ====================================================================
# ollama | anthropic | openai (or any OpenAI-compatible endpoint)
MNEMOS_LLM_PROVIDER=ollama
MNEMOS_LLM_MODEL=llama3.1:8b
# Required for anthropic / openai.
MNEMOS_LLM_API_KEY=
# OpenAI-compatible endpoint; overrides MNEMOS_OLLAMA_URL.
# MNEMOS_LLM_BASE_URL=
# Empty: probes the `ollama` service, host.docker.internal, then localhost,
# and keeps the first one with a model pulled.
MNEMOS_OLLAMA_URL=

# Changing it on an existing index needs a migration (docs/CONFIGURATION.md).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === Security and shared configuration ======================================
MNEMOS_AUTH_ENABLED=false
# Required with auth. Same value on both lines (`openssl rand -hex 32`); never
# set QDRANT__SERVICE__API_KEY empty, it locks every client out.
# QDRANT_API_KEY=
# QDRANT__SERVICE__API_KEY=
# Root tenant `admin`: cannot be edited, rotated or deleted from the dashboard;
# change this value and restart to rotate its key.
# MNEMOS_BOOTSTRAP_ADMIN_KEY=
# MNEMOS_TENANTS_PATH=/data/config/tenants.yaml
# Key sent by the watcher, the ingester (admin or write "*") and host clients.
# MNEMOS_API_KEY=
# Let the dashboard save configuration; with auth off anyone reaching :8100 can.
MNEMOS_UI_CONFIG_WRITABLE=false
# MNEMOS_CONFIG_POLL_SECONDS=5
# Index only the prefixes the projects mapping declares.
# MNEMOS_INDEX_ONLY_DECLARED_PATHS=false
# One-time import sources at the first start.
# MNEMOS_PROJECTS_CONFIG_PATH=/app/config/projects.yaml
# Also switches the CLI and the ingester from the server to this file; the
# ingester container mounts no config/, so setting it here breaks the ingester.
# MNEMOS_CONNECTORS_CONFIG=/app/config/connectors.yaml

# === Observability ==========================================================
MNEMOS_QUERY_LOG_ENABLED=false
# MNEMOS_QUERY_LOG_PATH=/data/state/query-log.jsonl

# === Retrieval and indexing (docs/RETRIEVAL_PIPELINE.md) ====================
# MNEMOS_RERANKER_ENABLED=false
# MNEMOS_RERANKER_MODEL=BAAI/bge-reranker-base
# MNEMOS_RERANKER_TYPE=cross-encoder
# MNEMOS_RERANKER_MAX_LENGTH=256
# MNEMOS_MMR_ENABLED=false
# MNEMOS_MMR_LAMBDA=0.5
# MNEMOS_GRADER_ENABLED=false
# MNEMOS_GRADER_WORKERS=4
# MNEMOS_REWRITER_ENABLED=false
# MNEMOS_REWRITER_STRATEGY=expansion      # expansion | decompose | hyde
# MNEMOS_REWRITER_MAX_VARIANTS=3
# MNEMOS_CACHE_ENABLED=false
# MNEMOS_CACHE_THRESHOLD=0.95
# MNEMOS_CACHE_TTL_SECONDS=3600
# MNEMOS_FUSION_DENSE_WEIGHT=3.0
# MNEMOS_RESPONSE_BUDGET_CHARS=32000
# MNEMOS_CONTEXTUAL_ENABLED=false
# MNEMOS_CONTEXTUAL_WORKERS=4
# MNEMOS_MAX_CHUNK_CHARS=0

# === Memory =================================================================
# Calibrated: the one real near-duplicate pair sat at 0.844, the next at 0.646.
MNEMOS_DEDUP_THRESHOLD=0.80
# MNEMOS_DEDUP_STRATEGY=merge             # merge | replace

# === Watcher ================================================================
# WATCHER_DEBOUNCE_MS=2000

# === Connectors (ingester) ==================================================
# Variables named by the connectors' `token_env` (CONFLUENCE_TOKEN, JIRA_TOKEN
# in config/connectors.example.yaml); all of them are also the defaults of the
# `mnemos ingest confluence|jira|git` flags.
# CONFLUENCE_URL=
# CONFLUENCE_USER=
# CONFLUENCE_TOKEN=
# JIRA_URL=
# JIRA_USER=
# JIRA_TOKEN=
# GIT_USER=
# GIT_TOKEN=
# Extra CA bundle behind a TLS-inspecting proxy.
# SSL_CERT_FILE=

# === Host-side tools (read from your shell, never from this file) ===========
# `mnemos eval` working directory.
# MNEMOS_EVAL_ROOT=evals
# Git hooks: shell environment first, then ~/.config/mnemos/config.
# MNEMOS_CONFIG_FILE=~/.config/mnemos/config
# Must match MNEMOS_CODEBASE_HOST_PATH.
# MNEMOS_CODEBASE_ROOT=~/code
# MNEMOS_HOOK_TRIGGER=pre-push           # pre-push | post-commit | both
# MNEMOS_REPOS_CONFIG=~/.config/mnemos/repos
# MNEMOS_INDEX_REPOS_CONFIG=~/.config/mnemos/index-repos
# MNEMOS_MAX_INCREMENTAL_FILES=200
# MNEMOS_MAX_FILE_BYTES=1048576
