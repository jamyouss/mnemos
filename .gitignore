__pycache__/
*.pyc
*.egg-info/
dist/
build/
.env
.venv/
venv/
*.egg
.pytest_cache/
.DS_Store
.claude/
uv.lock

# Eval runs (generated artifacts)
evals/runs/*.json
evals/dataset/_candidates.yaml
# Your own golden set is local data, not source code. Keep only the example committed.
evals/dataset/golden.yaml
evals/dataset/golden.legacy-*.yaml

# User-mounted dirs — keep .gitkeep placeholders but ignore the rest
data/codebase/*
!data/codebase/.gitkeep
data/claude-config/*
!data/claude-config/.gitkeep
config/projects.yaml
config/tenants.yaml

# Dashboard build artefacts
ui/node_modules/
ui/.nuxt/
ui/.output/
# `nuxt generate` leaves this as a symlink to an absolute path on the build
# machine — the `dist/` rule above only matches directories, so it needs its
# own line or it gets committed with someone's home path in it.
ui/dist
